APP_ENV=development
APP_NAME=Internal-Policy-Helpdesk
API_V1_PREFIX=/api/v1
BACKEND_CORS_ORIGINS=http://localhost:5173

POSTGRES_DB=nodeswarm
POSTGRES_USER=nodeswarm
POSTGRES_PASSWORD=nodeswarm_dev_only
POSTGRES_APP_USER=nodeswarm_app
POSTGRES_APP_PASSWORD=nodeswarm_app_dev_only
DATABASE_URL=postgresql+psycopg://nodeswarm_app:nodeswarm_app_dev_only@postgres:5432/nodeswarm
DATABASE_MIGRATION_URL=postgresql+psycopg://nodeswarm:nodeswarm_dev_only@postgres:5432/nodeswarm

QDRANT_URL=http://qdrant:6333
QDRANT_COLLECTION=policy_chunks
POLICY_KNOWLEDGE_DIR=knowledge
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
POLICY_CHUNK_SIZE=1400
POLICY_CHUNK_OVERLAP=160

KEYCLOAK_ISSUER_URL=http://keycloak:8080/realms/nodeswarm
KEYCLOAK_AUDIENCE=nodeswarm-api
KEYCLOAK_JWKS_URL=http://keycloak:8080/realms/nodeswarm/protocol/openid-connect/certs

LLM_PROVIDER=gemini
GEMINI_API_KEY=
LLM_ROUTER_MODEL=gemini-2.5-flash
LLM_SYNTHESIS_MODEL=gemini-2.5-pro

LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=nodeswarm
PRESIDIO_ENABLED=true
INPUT_MAX_CHARACTERS=8000
GEMINI_TIMEOUT_SECONDS=30
MODEL_MAX_OUTPUT_TOKENS=1200
RETRIEVAL_RETRY_ATTEMPTS=2
OTEL_EXPORTER_OTLP_ENDPOINT=
MAX_DOMAIN_HANDOFFS=2
MAX_TOTAL_STEPS=8
